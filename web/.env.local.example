# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secrets protecting /api/monitor. CRON_SECRET is auto-injected by Vercel
# when crons run; set MONITOR_SECRET for manual curl triggers.
MONITOR_SECRET=
CRON_SECRET=

# Anthropic API for signal summarization + diff explanation
ANTHROPIC_API_KEY=

# Discord webhook URL — when set, new signals are posted here
DISCORD_WEBHOOK_URL=

# Public URL of this app — used for links in notifications
APP_URL=http://localhost:3000

# URL of the Python scraper microservice
SCRAPER_URL=http://localhost:8000
